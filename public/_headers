# Cabeceras de seguridad de la app en Cloudflare (Workers + archivos estáticos). Son las MISMAS de `vercel.json`: si se cambia una, se cambia en las dos.
# Cloudflare las lee de este archivo al publicar; el CSP deja leer videos de `videos.traininglabapp.com` (ver docs/dominio.md).
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://cloudflareinsights.com https://*.supabase.co wss://*.supabase.co https://*.r2.cloudflarestorage.com https://*.r2.dev https://videos.traininglabapp.com; frame-src https:; worker-src 'self' blob:
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Los links de invitación y los QR abren la app de iPhone (Universal Links): Apple pide este archivo sin extensión y como JSON, sin redirecciones.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

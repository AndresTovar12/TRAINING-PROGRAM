{
  "appId": "com.traininglabapp.app",
  "appName": "Training Lab",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F2F3F7"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#F2F3F7"
    },
    "Keyboard": {
      "resize": "native"
    },
    "SocialLogin": {
      "providers": {
        "google": false,
        "facebook": false,
        "apple": true,
        "twitter": false
      }
    }
  }
}

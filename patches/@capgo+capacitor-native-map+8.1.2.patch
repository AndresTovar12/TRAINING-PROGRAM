+/// La cámara que sigue al corredor de UN mapa (ver `followCamera`).
+final class SeguidorDeCamara: NSObject {
+    static var todos = [String: SeguidorDeCamara]()
+
+    weak var plugin: NativeMapPlugin?
+    weak var mapView: MKMapView?
+    let id: String
+    private var enlace: CADisplayLink?
+
+    // Lo que se pidió (objetivo) y por dónde va (actual).
+    private var desde: CLLocationCoordinate2D
+    private var hacia: CLLocationCoordinate2D
+    private var centro: CLLocationCoordinate2D
+    private var inicio: CFTimeInterval = 0
+    private var duracion: Double = 0
+    var distancia: Double
+    var inclinacion: Double
+    var giro: Double
+    private var distanciaActual: Double
+    private var inclinacionActual: Double
+    private var giroActual: Double
+    private var distanciaPorZoom = [Double: Double]()
+    private var ultimoPuntoEnviado: CGPoint?

+            m.ponHalo(radio: hypot(otro.x - punto.x, otro.y - punto.y))
+        } else {
+            m.ponHalo(radio: nil)
+        }
+    }
+
+    /// El cono apunta hacia donde va (GPS, si va rápido) o hacia donde mira el iPhone (brújula), visto en la pantalla: menos lo que ya giró el mapa.
+    private func mueveCono() {

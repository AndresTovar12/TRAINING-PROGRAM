@@ -14,13 +14,32 @@ extension Map {
 
     /// Follow the user's location (and optionally heading). A non-`none` mode turns
     /// the user-location dot on; the host app still needs location permission.
-    func setUserTrackingMode(_ mode: String) {
+    func setUserTrackingMode(_ mode: String, distance: Double? = nil, pitch: Double? = nil) {
         DispatchQueue.main.async {
             let tracking = Map.userTrackingMode(from: mode)
+            // Training Lab (parche): al seguir al usuario MapKit pone SU distancia (lejos) y pelea con cualquier cámara que se le ponga encima (el mapa
+            // se acercaba y se volvía a alejar). En vez de pelear, se le pone un RANGO de distancia que MapKit respeta mientras sigue. Sin seguir, sin rango.
+            if tracking == .none {
+                self.mapView.cameraZoomRange = nil
+            } else if let d = distance, d > 0,
+                      let rango = MKMapView.CameraZoomRange(minCenterCoordinateDistance: d * 0.7, maxCenterCoordinateDistance: d * 1.4) {
+                self.mapView.setCameraZoomRange(rango, animated: false)
+            }
             if tracking != .none {
                 self.mapView.showsUserLocation = true
             }
             self.mapView.setUserTrackingMode(tracking, animated: true)
+            // La inclinación (3D) se aplica cuando MapKit ya tomó la cámara, sin dejar de seguir.
+            guard tracking != .none, let p = pitch else { return }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.6) {
+                guard let camara = self.mapView.camera.copy() as? MKMapCamera else { return }
+                camara.pitch = CGFloat(max(0, min(p, 60)))
+                if let d = distance, d > 0 { camara.centerCoordinateDistance = d }
+                self.mapView.setCamera(camara, animated: true)
+                if self.mapView.userTrackingMode != tracking {
+                    self.mapView.setUserTrackingMode(tracking, animated: false)
+                }
+            }
         }
     }
 

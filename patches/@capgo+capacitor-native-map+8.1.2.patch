+    // MARK: Brújula del teléfono (parche de Training Lab)
+    // Hacia dónde apunta el iPhone, para girar el mapa como Apple Maps, Strava y Aura. Se avisa a la página con el evento `onHeading` (grados desde el norte).
+
+    @objc func startHeading(_ call: CAPPluginCall) {
+        guard CLLocationManager.headingAvailable() else { call.resolve(["disponible": false]); return }
+        DispatchQueue.main.async {
+            let manager = self.ensureLocationManager()
+            manager.headingFilter = 2
+            manager.headingOrientation = .portrait
+            manager.startUpdatingHeading()
+            call.resolve(["disponible": true])
+        }
+    }
+
+    @objc func stopHeading(_ call: CAPPluginCall) {
+        DispatchQueue.main.async {
+            self.ensureLocationManager().stopUpdatingHeading()
+            call.resolve()
+        }
+    }
+
+    /// Qué mapas giran SOLOS con la brújula (los pide la página con `setHeadingFollow`) y el último rumbo suavizado.
+    enum HeadingFollow {
+        static var ids = Set<String>()
+        static var suavizado: Double?
+    }
+
+    @objc func setHeadingFollow(_ call: CAPPluginCall) {
+        guard let id = call.getString("id") else { call.reject("id requerido"); return }
+        let activo = call.getBool("enabled", true)
+        DispatchQueue.main.async {
+            if activo { HeadingFollow.ids.insert(id) } else { HeadingFollow.ids.remove(id) }
+            call.resolve()
+        }
+    }
+
+    public func locationManager(_ manager: CLLocationManager, didUpdateHeading newHeading: CLHeading) {
+        // Una precisión negativa quiere decir que la brújula no está calibrada: no se usa.
+        guard newHeading.headingAccuracy >= 0 else { return }
+        let nuevo = newHeading.trueHeading >= 0 ? newHeading.trueHeading : newHeading.magneticHeading
+        // Se suaviza por el camino corto (355° → 5° no da la vuelta entera).
+        var suave = nuevo
+        if let previo = HeadingFollow.suavizado {
+            var diferencia = nuevo - previo
+            while diferencia > 180 { diferencia -= 360 }
+            while diferencia < -180 { diferencia += 360 }
+            suave = (previo + 0.4 * diferencia + 360).truncatingRemainder(dividingBy: 360)
+        }
+        HeadingFollow.suavizado = suave
+        // El giro lo hace el iPhone mismo, de forma continua (animación corta que arranca desde donde va): así no se siente a tirones como al pedirlo desde la página.
+        for id in HeadingFollow.ids {
+            guard let map = maps[id], let camara = map.mapView.camera.copy() as? MKMapCamera else { continue }
+            camara.heading = suave
+            UIView.animate(withDuration: 0.3, delay: 0, options: [.beginFromCurrentState, .curveLinear, .allowUserInteraction]) {
+                map.mapView.camera = camara
+            }
+        }
+        notifyListeners("onHeading", data: ["heading": suave, "accuracy": newHeading.headingAccuracy])
+    }

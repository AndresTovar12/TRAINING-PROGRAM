+    }
+
+    private func pinta() {
+        guard let mapa = mapView else { return }
+        // Lo que mira la cámara: el corredor; o, mientras regresa de donde la dejó el dedo, un punto entre los dos.
+        var mira = centro
+        if let r = regresoDesde {
+            let g = min(1, (CACurrentMediaTime() - regresoInicio) / 0.8)
+            let suave = g * g * (3 - 2 * g)
+            mira = CLLocationCoordinate2D(latitude: r.latitude + (centro.latitude - r.latitude) * suave, longitude: r.longitude + (centro.longitude - r.longitude) * suave)
+            if g >= 1 { regresoDesde = nil }
+        }
+        // ¿Hace falta escribir la cámara? No mientras está congelada (cambio de tipo de mapa), ni si nada cambió lo suficiente para verse. El punto se
+        // coloca igual. Mientras regresa de donde la dejó el dedo, siempre.
+        let ahora = CACurrentMediaTime()
+        if regresoDesde == nil {
+            if ahora < congeladoHasta { colocaMarcador(en: mapa); return }
+            let pantalla = mapa.convert(mira, toPointTo: mapa)
+            let poco = ultimoPuntoEscrito.map { hypot(pantalla.x - $0.x, pantalla.y - $0.y) < 0.5 } ?? false
+                && abs(SeguidorDeCamara.diferencia(ultimoGiroEscrito, giroActual)) < 0.2
+                && abs(inclinacionActual - ultimaInclinacionEscrita) < 0.2
+                && abs(distanciaActual - ultimaDistanciaEscrita) < ultimaDistanciaEscrita * 0.005
+            if poco { colocaMarcador(en: mapa); return }
+        }
+        let camara = MKMapCamera(lookingAtCenter: mira, fromDistance: distanciaActual, pitch: CGFloat(inclinacionActual), heading: giroActual)
+        mapa.camera = camara
+        // El corredor va en medio de lo que NO tapan los márgenes del mapa (el panel de abajo), no en medio de la pantalla: no se sabe si MapKit respeta los
+        // márgenes con esta cámara, así que se mide. Si el corredor no cayó ahí, se recorre el centro de la cámara lo que haga falta (revisión de Fable 5).
+        // Si MapKit ya los respeta, no se corrige nada.
+        let b = mapa.bounds
+        let m = mapa.layoutMargins
+        let visto = mapa.convert(mira, toPointTo: mapa)
+        if b.width > 0, b.height > 0 {
+            let deseado = CGPoint(x: b.minX + m.left + (b.width - m.left - m.right) / 2, y: b.minY + m.top + (b.height - m.top - m.bottom) / 2)
+            if hypot(visto.x - deseado.x, visto.y - deseado.y) > 1 {
+                let bajoDeseado = mapa.convert(deseado, toCoordinateFrom: mapa)
+                camara.centerCoordinate = CLLocationCoordinate2D(
+                    latitude: mira.latitude + (mira.latitude - bajoDeseado.latitude),
+                    longitude: mira.longitude + (mira.longitude - bajoDeseado.longitude)
+                )
+                mapa.camera = camara
+            }
+        }
+        ultimoPuntoEscrito = mapa.convert(mira, toPointTo: mapa)
+        ultimoGiroEscrito = giroActual
+        ultimaInclinacionEscrita = inclinacionActual
+        ultimaDistanciaEscrita = distanciaActual
+        // El punto propio va justo donde quedó el corredor, en el mismo cuadro que la cámara: no se separan.
+        colocaMarcador(en: mapa)
+    }
+
+    /// El punto en el lugar del corredor y, si el GPS anda impreciso (más de 15 m), su círculo de precisión del tamaño real en el mapa.
+    private func colocaMarcador(en mapa: MKMapView) {
+        guard let m = marcador else { return }
+        let punto = mapa.convert(centro, toPointTo: mapa)
+        m.center = punto
+        if let p = precisionGps, p > 15 {
+            let norte = CLLocationCoordinate2D(latitude: centro.latitude + p / 111195, longitude: centro.longitude)

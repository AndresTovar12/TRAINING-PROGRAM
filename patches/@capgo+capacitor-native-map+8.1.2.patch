+        if !siguiendo {
+            centro = nuevoCentro
+            giroActual = mapa.camera.heading
+            mueveCono()
+            colocaMarcador(en: mapa)
+            return
+        }
+        // Giro, inclinación y distancia: una fracción por cuadro (a 60 cuadros por segundo, ~0.3 s para llegar casi entero).

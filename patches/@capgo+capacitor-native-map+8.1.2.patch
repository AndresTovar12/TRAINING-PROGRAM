+
+    private static func diferencia(_ a: Double, _ b: Double) -> Double {
+        var d = (b - a).truncatingRemainder(dividingBy: 360)
+        if d > 180 { d -= 360 }
+        if d < -180 { d += 360 }
+        return d
+    }
+
+    @objc private func cuadro() {
+        guard let mapa = mapView else { para(); SeguidorDeCamara.todos.removeValue(forKey: id); return }
+        let f = duracion > 0 ? min(1, (CACurrentMediaTime() - inicio) / duracion) : 1

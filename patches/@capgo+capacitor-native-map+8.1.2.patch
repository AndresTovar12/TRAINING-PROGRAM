+    /// La distancia de cámara que da el mismo encuadre que el `zoom` del plugin (la misma cuenta que `setCamera`), calculada una vez por zoom.
+    func distanciaPara(zoom: Double, minZoom: Double?, maxZoom: Double?) -> Double {
+        if let d = distanciaPorZoom[zoom] { return d }
+        guard let mapa = mapView else { return distancia }
+        let z = clampZoom(zoom, minZoom: minZoom, maxZoom: maxZoom)
+        let ancho = Double(mapa.bounds.width > 0 ? mapa.bounds.width : UIScreen.main.bounds.width)
+        let alto = Double(mapa.bounds.height > 0 ? mapa.bounds.height : UIScreen.main.bounds.height)
+        let lonDelta = min(zoomToLongitudeDelta(z, widthPoints: ancho), 360.0)
+        let span = MKCoordinateSpan(latitudeDelta: min(lonDelta * (alto / max(ancho, 1)), 180.0), longitudeDelta: lonDelta)
+        // Se pone la región sin animar, se lee su distancia y se regresa la cámara: todo en el mismo instante, no se ve.
+        let antes = mapa.camera.copy() as? MKMapCamera
+        mapa.setRegion(mapa.regionThatFits(MKCoordinateRegion(center: centro, span: span)), animated: false)
+        let d = mapa.camera.centerCoordinateDistance
+        if let antes = antes { mapa.setCamera(antes, animated: false) }
+        distanciaPorZoom[zoom] = d
+        return d
+    }
+
+    /// El siguiente punto: el centro se desliza desde donde va AHORA hasta ahí, en `segundos` (el tiempo entre dos puntos del GPS).
+    func irA(_ destino: CLLocationCoordinate2D, en segundos: Double) {
+        desde = centro
+        hacia = destino
+        inicio = CACurrentMediaTime()
+        duracion = segundos
+    }
+
+    /// Todo llega de golpe (al abrir el mapa o desde muy lejos).
+    func llegaYa() {
+        desde = hacia; centro = hacia; duracion = 0
+        distanciaActual = distancia; inclinacionActual = inclinacion; giroActual = giro
+        pinta()
+    }
+
+    func arranca() {
+        guard enlace == nil else { return }
+        let e = CADisplayLink(target: self, selector: #selector(cuadro))
+        e.add(to: .main, forMode: .common)
+        enlace = e
+    }
+
+    func para() {
+        enlace?.invalidate()
+        enlace = nil
+    }
+
+    private static func diferencia(_ a: Double, _ b: Double) -> Double {
+        var d = (b - a).truncatingRemainder(dividingBy: 360)
+        if d > 180 { d -= 360 }
+        if d < -180 { d += 360 }
+        return d
+    }

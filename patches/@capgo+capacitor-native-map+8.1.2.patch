+
+    /// Un rumbo que se acerca 0.4 hacia otro por el camino corto (355° → 5° no da la vuelta entera): el mismo suavizado de la brújula.
+    static func acerca(_ desde: Double, a hacia: Double) -> Double {
+        (desde + 0.4 * diferencia(desde, hacia) + 360).truncatingRemainder(dividingBy: 360)

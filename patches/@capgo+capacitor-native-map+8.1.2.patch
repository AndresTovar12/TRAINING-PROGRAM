+
+/// El corredor en el mapa (27 oct 2026): halo azul translúcido, aro blanco, punto azul y el cono de dirección con degradado. Una sola pieza nativa, como en
+/// Apple Maps, Google Maps y Strava; no recibe toques (los toques siguen yendo al mapa o a la página).
+final class VistaDelCorredor: UIView {
+    private let cono = CALayer()
+    private let formaDelCono = CAShapeLayer()
+    private let degradado = CAGradientLayer()
+    private var aberturaActual: Double = -1
+    private let haloFijo = CAShapeLayer()
+    private let haloDePrecision = CAShapeLayer()
+    private var radioDelHalo: CGFloat = -1
+    private static let lado: CGFloat = 140
+    private static let azul = UIColor(red: 0.18, green: 0.42, blue: 1.0, alpha: 1)
+
+    init() {
+        super.init(frame: CGRect(x: 0, y: 0, width: VistaDelCorredor.lado, height: VistaDelCorredor.lado))
+        isUserInteractionEnabled = false
+        backgroundColor = .clear
+        let medio = CGPoint(x: bounds.midX, y: bounds.midY)
+
+        // El cono: un degradado azul que se desvanece hacia afuera, recortado con la forma de una rebanada que sale del centro hacia arriba.
+        cono.frame = bounds
+        degradado.frame = bounds
+        degradado.type = .radial
+        degradado.colors = [VistaDelCorredor.azul.withAlphaComponent(0.55).cgColor, VistaDelCorredor.azul.withAlphaComponent(0).cgColor]
+        degradado.startPoint = CGPoint(x: 0.5, y: 0.5)
+        degradado.endPoint = CGPoint(x: 1, y: 1)
+        degradado.mask = formaDelCono
+        formaDelCono.frame = bounds
+        // El círculo de precisión va detrás de todo; puede salirse del cuadro de la vista (las capas no se recortan).
+        haloDePrecision.fillColor = VistaDelCorredor.azul.withAlphaComponent(0.12).cgColor
+        haloDePrecision.strokeColor = VistaDelCorredor.azul.withAlphaComponent(0.35).cgColor
+        haloDePrecision.lineWidth = 1
+        haloDePrecision.isHidden = true
+        layer.addSublayer(haloDePrecision)
+        cono.addSublayer(degradado)
+        layer.addSublayer(cono)
+
+        let circulo = { (radio: CGFloat, color: UIColor) -> CAShapeLayer in
+            let c = CAShapeLayer()
+            c.path = UIBezierPath(arcCenter: medio, radius: radio, startAngle: 0, endAngle: .pi * 2, clockwise: true).cgPath
+            c.fillColor = color.cgColor
+            return c
+        }
+        haloFijo.path = UIBezierPath(arcCenter: medio, radius: 22, startAngle: 0, endAngle: .pi * 2, clockwise: true).cgPath
+        haloFijo.fillColor = VistaDelCorredor.azul.withAlphaComponent(0.18).cgColor
+        layer.addSublayer(haloFijo) // halo
+        let aro = circulo(10, .white)
+        aro.shadowColor = UIColor.black.cgColor
+        aro.shadowOpacity = 0.3
+        aro.shadowRadius = 3
+        aro.shadowOffset = CGSize(width: 0, height: 1)
+        layer.addSublayer(aro)
+        layer.addSublayer(circulo(7.5, VistaDelCorredor.azul)) // punto
+        ponCono(visible: false)
+    }
+
+    required init?(coder: NSCoder) { fatalError("no se usa desde un storyboard") }
+
+    /// `nil`: el halo fijo de siempre. Con un radio (en puntos): el círculo de precisión del GPS de ese tamaño, en lugar del halo fijo.
+    func ponHalo(radio: CGFloat?) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        if let r = radio, r > 22 {
+            haloFijo.isHidden = true
+            haloDePrecision.isHidden = false
+            if abs(r - radioDelHalo) > 0.5 {
+                radioDelHalo = r
+                haloDePrecision.path = UIBezierPath(arcCenter: CGPoint(x: bounds.midX, y: bounds.midY), radius: r, startAngle: 0, endAngle: .pi * 2, clockwise: true).cgPath
+            }
+        } else {
+            haloFijo.isHidden = false
+            haloDePrecision.isHidden = true
+        }
+        CATransaction.commit()
+    }
+
+    /// Gira el cono `grados` (0 = hacia arriba de la pantalla) y lo abre `abertura` grados hacia cada lado.
+    func ponCono(visible: Bool, grados: Double = 0, abertura: Double = 30) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true) // sin animaciones implícitas: lo mueve el cuadro
+        cono.isHidden = !visible
+        if visible {
+            if abs(abertura - aberturaActual) > 1 {
+                aberturaActual = abertura
+                let medio = CGPoint(x: bounds.midX, y: bounds.midY)
+                let radio = bounds.width / 2
+                let arriba = -Double.pi / 2
+                let a = abertura * .pi / 180
+                let ruta = UIBezierPath()
+                ruta.move(to: medio)
+                ruta.addArc(withCenter: medio, radius: radio, startAngle: CGFloat(arriba - a), endAngle: CGFloat(arriba + a), clockwise: true)
+                ruta.close()
+                formaDelCono.path = ruta.cgPath
+            }
+            cono.setAffineTransform(CGAffineTransform(rotationAngle: CGFloat(grados * .pi / 180)))
+        }
+        CATransaction.commit()
+    }
+}

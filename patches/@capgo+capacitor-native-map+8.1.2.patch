+    init(plugin: NativeMapPlugin, id: String, mapView: MKMapView) {
+        self.plugin = plugin
+        self.id = id
+        self.mapView = mapView
+        // Se arranca desde donde está la cámara AHORA (se lee una sola vez, al crearse; después nunca).
+        let camara = mapView.camera
+        desde = camara.centerCoordinate; hacia = camara.centerCoordinate; centro = camara.centerCoordinate
+        distancia = camara.centerCoordinateDistance; distanciaActual = camara.centerCoordinateDistance
+        inclinacion = Double(camara.pitch); inclinacionActual = Double(camara.pitch)

+// Training Lab: la RUTA de un entreno (HKWorkoutRoute), punto por punto. `workoutId` es el `platformId` de queryWorkouts (el UUID de HealthKit).
+// Devuelve `{ locations: [{ lat, lon, alt, t (ms), acc }] }`; sin ruta (o sin permiso), una lista vacía.
+extension Health {
+    func queryWorkoutRoute(workoutId: String, completion: @escaping (Result<[String: Any], Error>) -> Void) {
+        guard let uuid = UUID(uuidString: workoutId) else {
+            completion(.success(["locations": []]))
+            return
+        }
+        let buscaEntreno = HKSampleQuery(sampleType: HKObjectType.workoutType(), predicate: HKQuery.predicateForObject(with: uuid), limit: 1, sortDescriptors: nil) { [weak self] _, samples, error in
+            guard let self = self else { return }
+            if let error = error {
+                completion(.failure(error))
+                return
+            }
+            guard let workout = samples?.first as? HKWorkout else {
+                completion(.success(["locations": []]))
+                return
+            }
+            let orden = [NSSortDescriptor(key: HKSampleSortIdentifierStartDate, ascending: true)]
+            let buscaRutas = HKSampleQuery(sampleType: HKSeriesType.workoutRoute(), predicate: HKQuery.predicateForObjects(from: workout), limit: HKObjectQueryNoLimit, sortDescriptors: orden) { _, rutas, error in
+                if let error = error {
+                    completion(.failure(error))
+                    return
+                }
+                let lista = (rutas as? [HKWorkoutRoute]) ?? []
+                if lista.isEmpty {
+                    completion(.success(["locations": []]))
+                    return
+                }
+                let candado = NSLock()
+                let grupo = DispatchGroup()
+                var porRuta = Array(repeating: [[String: Any]](), count: lista.count)
+                for (i, ruta) in lista.enumerated() {
+                    grupo.enter()
+                    var puntos: [[String: Any]] = []
+                    var terminada = false
+                    let consulta = HKWorkoutRouteQuery(route: ruta) { _, locations, done, error in
+                        if terminada { return }
+                        for l in locations ?? [] {
+                            puntos.append([
+                                "lat": l.coordinate.latitude, "lon": l.coordinate.longitude, "alt": l.altitude,
+                                "t": l.timestamp.timeIntervalSince1970 * 1000, "acc": l.horizontalAccuracy,
+                            ])
+                        }
+                        if done || error != nil {
+                            terminada = true
+                            candado.lock()
+                            porRuta[i] = puntos
+                            candado.unlock()
+                            grupo.leave()
+                        }
+                    }
+                    self.healthStore.execute(consulta)
+                }
+                grupo.notify(queue: DispatchQueue.global()) {
+                    completion(.success(["locations": porRuta.flatMap { $0 }]))
+                }
+            }
+            self.healthStore.execute(buscaRutas)
+        }
+        healthStore.execute(buscaEntreno)
+    }
+}

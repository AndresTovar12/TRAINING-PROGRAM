// La app de Training Lab en Cloudflare: los archivos de `dist/` (se arman con `npm run build`) + el reenvío del conector de IA (`worker-app.js`).
// Se publica con:  cd cloudflare && npx wrangler@latest deploy   (después de `npm run build` en la raíz). Ver docs/dominio.md, sección 5.
{
  "name": "training-lab-app",
  "main": "worker-app.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    // Lo que no es un archivo (por ejemplo /entrenar) se contesta con index.html: la app decide qué pantalla enseñar.
    "not_found_handling": "single-page-application",
    // Solo estas direcciones pasan por el programa; todo lo demás son archivos gratis y sin límite.
    "run_worker_first": ["/mcp", "/mcp/*", "/.well-known/oauth-*"]
  },
  "routes": [{ "pattern": "app.traininglabapp.com", "custom_domain": true }]
}
